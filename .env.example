# Public URL of the deployed app (no trailing slash). Used for OAuth + password-reset redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth client (type: Web application). Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# 32-byte key, base64 encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_ENCRYPTION_KEY=

# Optional: Gmail push notifications via Google Cloud Pub/Sub.
# Topic format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Random secret appended to the Pub/Sub push endpoint URL as ?token=...
GMAIL_PUSH_TOKEN=

# Secret for the scheduled sync endpoint (/api/cron/sync). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# "gmail" (default) or "mock" for local development without Google credentials.
# The mock provider is clearly labelled in the UI and never pretends to be Gmail.
MAIL_PROVIDER=gmail
